generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  name       String?  @db.VarChar(100)
  role       UserRole @default(member)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([role])
  @@index([created_at])
  @@map("users")
}

model DomainInfo {
  id                 BigInt    @id @default(autoincrement())
  domain             String    @unique @db.VarChar(255)
  tld                String?   @db.VarChar(10)
  registration_date  DateTime? @db.Timestamptz(6)
  expiration_date    DateTime? @db.Timestamptz(6)
  updated_date       DateTime? @db.Timestamptz(6)
  registrar          String?   @db.VarChar(255)
  nameservers        String[]
  global_rank        BigInt?
  monthly_visits     BigInt?
  bounce_rate        Decimal?  @db.Decimal(5, 2)
  pages_per_visit    Decimal?  @db.Decimal(10, 2)
  avg_visit_duration BigInt?
  traffic_direct     Decimal?  @db.Decimal(5, 2)
  traffic_search     Decimal?  @db.Decimal(5, 2)
  traffic_social     Decimal?  @db.Decimal(5, 2)
  traffic_referral   Decimal?  @db.Decimal(5, 2)
  traffic_queried    Boolean?  @default(false)
  whois_queried      Boolean?  @default(false)
  last_updated       DateTime? @default(now()) @db.Timestamptz(6)
  category           String?   @db.VarChar(100)
  is_adult           Boolean?  @default(false)
  is_movie           Boolean?  @default(false)
  is_trending        Boolean?  @default(false)
  country_code       String?   @db.VarChar(2)
  country_rank       BigInt?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  domain_status      String[]
  title              String?   @db.VarChar(500)
  description        String?
  category_rank      Int?
  category_name      String?   @db.VarChar(100)
  traffic_period     String?   @db.VarChar(20)
  traffic_paid       Decimal?  @db.Decimal(5, 2)
  traffic_mail       Decimal?  @db.Decimal(5, 2)
  monthly_trend      Json?
  top_countries      Json?
  top_keywords       Json?

  @@index([category], map: "idx_category")
  @@index([country_code], map: "idx_domain_info_country_code")
  @@index([country_rank], map: "idx_domain_info_country_rank")
  @@index([monthly_visits(sort: Desc)], map: "idx_monthly_visits")
  @@index([registration_date(sort: Desc)], map: "idx_registration_date")
  @@index([top_keywords], map: "idx_top_keywords", type: Gin)
  @@index([global_rank(sort: Asc)], map: "idx_domain_global_rank")
  @@index([bounce_rate], map: "idx_domain_bounce_rate")
  @@index([domain], map: "idx_domain_name")
  @@index([created_at(sort: Desc)], map: "idx_domain_created_at")
  @@map("domain_info")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model new_domains_queue {
  id                   BigInt    @id @default(autoincrement())
  domain               String    @db.VarChar(255)
  tld                  String?   @db.VarChar(10)
  discovered_date      DateTime  @db.Timestamptz(6)
  discovered_timestamp DateTime  @default(now()) @db.Timestamp(6)
  processing_status    String?   @default("pending") @db.VarChar(20)
  processed_at         DateTime? @db.Timestamp(6)
  retry_count          Int?      @default(0)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([domain, discovered_date])
  @@index([domain], map: "idx_queue_domain")
  @@index([processing_status, discovered_timestamp], map: "idx_queue_status_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  title       String       @db.VarChar(255)
  description String?
  status      TaskStatus   @default(pending)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @db.Timestamptz(6)
  parentId    String?
  assigneeId  String?
  tags        String[]     @default([])
  category    String?      @db.VarChar(50)
  progress    Int          @default(0) @db.SmallInt
  completedAt DateTime?    @db.Timestamptz(6)
  createdBy   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([assigneeId])
  @@index([createdAt])
  @@index([dueDate])
  @@index([parentId])
  @@index([priority])
  @@index([status])
}

enum UserRole {
  super_admin
  admin
  member
  viewer
}

enum TaskPriority {
  urgent
  high
  medium
  low
}

enum TaskStatus {
  pending
  in_progress
  review
  completed
  cancelled
  blocked
}
